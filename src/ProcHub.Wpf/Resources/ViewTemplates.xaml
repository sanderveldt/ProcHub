<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dashboardVm="clr-namespace:ProcHub.Wpf.Features.Dashboard.ViewModels"
    xmlns:dashboardViews="clr-namespace:ProcHub.Wpf.Features.Dashboard.Views"
    xmlns:suppliersVm="clr-namespace:ProcHub.Wpf.Features.Suppliers.ViewModels"

    <DataTemplate DataType="{x:Type dashboardVm:DashboardViewModel}">
        <dashboardViews:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type suppliersVm:SuppliersViewModel}">
        <shellViews:ModulePlaceholderView />
    </DataTemplate>

</ResourceDictionary>