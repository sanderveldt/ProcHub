<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellViews="clr-namespace:ProcHub.Wpf.Shell.Views"
    xmlns:homeVm="clr-namespace:ProcHub.Wpf.Features.Home.ViewModels"
    xmlns:homeViews="clr-namespace:ProcHub.Wpf.Features.Home.Views"
    xmlns:settingsVm="clr-namespace:ProcHub.Wpf.Features.Settings.ViewModels"
    xmlns:usersVm="clr-namespace:ProcHub.Wpf.Features.Users.ViewModels"
    xmlns:purchaseOrdersVm="clr-namespace:ProcHub.Wpf.Features.PurchaseOrders.Open.Dashboard.ViewModels"
    xmlns:suppliersVm="clr-namespace:ProcHub.Wpf.Features.Suppliers.ViewModels"
    xmlns:paymentTermsVm="clr-namespace:ProcHub.Wpf.Features.PaymentTerms.ViewModels"
    xmlns:paymentTermsViews="clr-namespace:ProcHub.Wpf.Features.PaymentTerms.Views"
    xmlns:shippingTermsVm="clr-namespace:ProcHub.Wpf.Features.ShippingTerms.ViewModels"
    xmlns:shippingTermsViews="clr-namespace:ProcHub.Wpf.Features.ShippingTerms.Views">

    <DataTemplate DataType="{x:Type homeVm:HomeViewModel}">
        <homeViews:HomeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type purchaseOrdersVm:DashboardViewModel}">
        <shellViews:PlaceholderView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type suppliersVm:SuppliersViewModel}">
        <shellViews:PlaceholderView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type paymentTermsVm:PaymentTermsViewModel}">
        <paymentTermsViews:PaymentTermsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type shippingTermsVm:ShippingTermsViewModel}">
        <shippingTermsViews:ShippingTermsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type usersVm:UsersViewModel}">
        <shellViews:PlaceholderView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
        <shellViews:PlaceholderView />
    </DataTemplate>

</ResourceDictionary>