  <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
         REUSABLE FLUENT DASHBOARD DATAGRID

         Expected row ViewModel states:
            bool    IsExpanded
            bool    IsDirty
            bool    IsSaving
            string? SaveError
    -->

    <!-- READ-ONLY CELL TEXT -->

    <Style x:Key="DashboardCellTextStyle"
           TargetType="{x:Type TextBlock}">

        <Setter Property="Margin"
                Value="8,0" />

        <Setter Property="VerticalAlignment"
                Value="Center" />

        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />

        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorPrimaryBrush}" />

    </Style>


    <!-- 
         NORMAL DATAGRID EDITOR
         Used by normal DataGridTextColumn editing.
         Use for occasionally changed columns.
    -->

    <Style x:Key="DashboardEditingTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">

        <Setter Property="Margin"
                Value="2,3" />

        <Setter Property="Padding"
                Value="8,4" />

        <Setter Property="MinHeight"
                Value="32" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

    </Style>


    <!-- 
         FREQUENTLY EDITED TEXTBOX
         Always visible inside the cell.
      -->

    <Style x:Key="DashboardInlineTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">

        <Setter Property="Margin"
                Value="2,3" />

        <Setter Property="Padding"
                Value="8,4" />

        <Setter Property="MinHeight"
                Value="32" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

        <!-- Slightly distinguish editable cells -->
        <Setter Property="Background"
                Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />

        <Setter Property="BorderBrush"
                Value="Transparent" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="{DynamicResource ControlAltFillColorTertiaryBrush}" />

                <Setter Property="BorderBrush"
                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />

            </Trigger>

            <Trigger Property="IsKeyboardFocusWithin"
                     Value="True">

                <Setter Property="Background"
                        Value="{DynamicResource ControlFillColorInputActiveBrush}" />

                <Setter Property="BorderBrush"
                        Value="{DynamicResource AccentFillColorDefaultBrush}" />

            </Trigger>

            <Trigger Property="Validation.HasError"
                     Value="True">

                <Setter Property="BorderBrush"
                        Value="{DynamicResource SystemFillColorCriticalBrush}" />

            </Trigger>

        </Style.Triggers>

    </Style>

    <!-- FREQUENTLY EDITED COMBOBOX -->

    <Style x:Key="DashboardInlineComboBoxStyle"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource {x:Type ComboBox}}">

        <Setter Property="Margin"
                Value="2,3" />

        <Setter Property="MinHeight"
                Value="32" />

        <Setter Property="MinWidth"
                Value="100" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

    </Style>


    <!-- DATAGRID COLUMN HEADER -->

    <Style x:Key="DashboardDataGridColumnHeaderStyle"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">

        <Setter Property="Padding"
                Value="10,0,8,0" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="FontSize"
                Value="12" />

        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorSecondaryBrush}" />

        <Setter Property="Background"
                Value="{DynamicResource SubtleFillColorSecondaryBrush}" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

        <Setter Property="HorizontalContentAlignment"
                Value="Left" />

    </Style>

    <!-- DATE CELLS -->

    <Style x:Key="DashboardDateTextBoxStyle"
       TargetType="{x:Type TextBox}"
       BasedOn="{StaticResource DashboardEditingTextBoxStyle}">

        <Setter Property="Width"
                Value="120" />

        <Setter Property="MaxLength"
                Value="10" />

        <Setter Property="ToolTip"
                Value="Format: dd-MM-yyyy" />

        <Style.Triggers>

                <Trigger Property="Validation.HasError"
                         Value="True">

                        <Setter Property="BorderBrush"
                                Value="{DynamicResource SystemFillColorCriticalBrush}" />

                        <Setter Property="ToolTip"
                                Value="{Binding
                                RelativeSource={RelativeSource Self},
                                Path=(Validation.Errors)[0].ErrorContent}" />

                </Trigger>

        </Style.Triggers>

     </Style>


    <!-- NORMAL DATAGRID CELL -->

    <Style x:Key="DashboardDataGridCellStyle"
           TargetType="{x:Type DataGridCell}"
           BasedOn="{StaticResource DefaultDataGridCellStyle}">

        <Setter Property="Padding"
                Value="4,0" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

    </Style>


    <!-- Less padding for cells containing TextBox/ComboBox controls. -->

    <Style x:Key="DashboardEditorCellStyle"
           TargetType="{x:Type DataGridCell}"
           BasedOn="{StaticResource DefaultDataGridCellStyle}">

        <Setter Property="Padding"
                Value="1,0" />

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

    </Style>


    <!-- 
         DATAGRID ROW
         IsExpanded controls RowDetails.
     -->

    <Style x:Key="DashboardDataGridRowStyle"
           TargetType="{x:Type DataGridRow}"
           BasedOn="{StaticResource DefaultDataGridRowStyle}">

        <Setter Property="MinHeight"
                Value="42" />

        <Setter Property="DetailsVisibility"
                Value="Collapsed" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsExpanded}"
                         Value="True">

                <Setter Property="DetailsVisibility"
                        Value="Visible" />

            </DataTrigger>

        </Style.Triggers>

    </Style>


    <!-- EXPAND BUTTON -->

    <Style x:Key="DashboardExpandButtonStyle"
           TargetType="{x:Type ToggleButton}">

        <Setter Property="Width"
                Value="30" />

        <Setter Property="Height"
                Value="30" />

        <Setter Property="HorizontalAlignment"
                Value="Center" />

        <Setter Property="VerticalAlignment"
                Value="Center" />

        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="BorderBrush"
                Value="Transparent" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ToggleButton}">

                    <Border x:Name="Root"
                            Width="30"
                            Height="30"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">

                        <Path x:Name="Chevron"
                              Width="12"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1 1 L 6 6 L 11 1"
                              Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">

                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>

                        </Path>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />

                        </Trigger>

                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">

                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusStrokeColorOuterBrush}" />

                        </Trigger>

                        <Trigger Property="IsChecked"
                                 Value="True">

                            <Setter TargetName="Chevron"
                                    Property="RenderTransform">

                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>

                            </Setter>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <DataTemplate x:Key="DashboardExpandCellTemplate">

        <ToggleButton
            Style="{StaticResource DashboardExpandButtonStyle}"
            IsChecked="{Binding IsExpanded,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Show order details"
            AutomationProperties.Name="Show order details" />

    </DataTemplate>


    <!-- 
         SAVE STATE INDICATOR

         Blank       = synchronized
         small dot   = unsaved changes
         progress    = saving
         red !       = save failed
     -->

    <DataTemplate x:Key="DashboardSaveStateCellTemplate">

        <Grid Width="34"
              Height="32">

            <!-- Pending / dirty -->

            <Ellipse x:Name="DirtyIndicator"
                     Width="7"
                     Height="7"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource SystemFillColorAttentionBrush}"
                     Visibility="Collapsed"
                     ToolTip="Unsaved changes" />


            <!-- Saving -->

            <ProgressBar x:Name="SavingIndicator"
                         Width="22"
                         Height="4"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         ToolTip="Saving changes..." />


            <!-- Error -->

            <Border x:Name="ErrorIndicator"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="11"
                    Background="{DynamicResource SystemFillColorCriticalBrush}"
                    ToolTip="{Binding SaveError}">

                <TextBlock
                    Text="!"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White" />

            </Border>

        </Grid>


        <DataTemplate.Triggers>

            <!-- Error hidden when SaveError == null -->

            <DataTrigger Binding="{Binding SaveError}"
                         Value="{x:Null}">

                <Setter TargetName="ErrorIndicator"
                        Property="Visibility"
                        Value="Collapsed" />

            </DataTrigger>


            <!-- Dirty but not currently saving -->

            <MultiDataTrigger>

                <MultiDataTrigger.Conditions>

                    <Condition Binding="{Binding IsDirty}"
                               Value="True" />

                    <Condition Binding="{Binding IsSaving}"
                               Value="False" />

                    <Condition Binding="{Binding SaveError}"
                               Value="{x:Null}" />

                </MultiDataTrigger.Conditions>

                <Setter TargetName="DirtyIndicator"
                        Property="Visibility"
                        Value="Visible" />

            </MultiDataTrigger>


            <!-- Request currently in progress -->

            <MultiDataTrigger>

                <MultiDataTrigger.Conditions>

                    <Condition Binding="{Binding IsSaving}"
                               Value="True" />

                    <Condition Binding="{Binding SaveError}"
                               Value="{x:Null}" />

                </MultiDataTrigger.Conditions>

                <Setter TargetName="SavingIndicator"
                        Property="Visibility"
                        Value="Visible" />

            </MultiDataTrigger>

        </DataTemplate.Triggers>

    </DataTemplate>


    <!-- MAIN DATAGRID STYLE -->

    <Style x:Key="DashboardDataGridStyle"
           TargetType="{x:Type DataGrid}"
           BasedOn="{StaticResource DefaultDataGridStyle}">

        <!-- Behaviour -->

        <Setter Property="AutoGenerateColumns"
                Value="False" />

        <Setter Property="CanUserAddRows"
                Value="False" />

        <Setter Property="CanUserDeleteRows"
                Value="False" />

        <Setter Property="CanUserResizeRows"
                Value="False" />

        <Setter Property="CanUserResizeColumns"
                Value="True" />

        <Setter Property="CanUserReorderColumns"
                Value="True" />

        <Setter Property="CanUserSortColumns"
                Value="True" />

        <Setter Property="HeadersVisibility"
                Value="Column" />

        <Setter Property="SelectionMode"
                Value="Single" />

        <Setter Property="SelectionUnit"
                Value="FullRow" />


        <!-- Dimensions -->

        <Setter Property="MinRowHeight"
                Value="42" />

        <Setter Property="ColumnHeaderHeight"
                Value="42" />

        <Setter Property="MinColumnWidth"
                Value="60" />


        <!-- Fluent dashboard appearance -->

        <Setter Property="Background"
                Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />

        <Setter Property="BorderBrush"
                Value="{DynamicResource CardStrokeColorDefaultBrush}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="Border.CornerRadius"
                Value="8" />


        <!-- Very subtle alternating rows -->

        <Setter Property="RowBackground"
                Value="Transparent" />

        <Setter Property="AlternationCount"
                Value="2" />

        <Setter Property="AlternatingRowBackground"
                Value="{DynamicResource SubtleFillColorSecondaryBrush}" />


        <!-- Only horizontal separators -->

        <Setter Property="GridLinesVisibility"
                Value="Horizontal" />

        <Setter Property="HorizontalGridLinesBrush"
                Value="{DynamicResource DividerStrokeColorDefaultBrush}" />


        <!-- Styles -->

        <Setter Property="ColumnHeaderStyle"
                Value="{StaticResource DashboardDataGridColumnHeaderStyle}" />

        <Setter Property="CellStyle"
                Value="{StaticResource DashboardDataGridCellStyle}" />

        <Setter Property="RowStyle"
                Value="{StaticResource DashboardDataGridRowStyle}" />


        <!-- Expanded row -->

        <Setter Property="RowDetailsVisibilityMode"
                Value="Collapsed" />

        <!-- Details remain stationary while columns scroll horizontally. -->

        <Setter Property="AreRowDetailsFrozen"
                Value="True" />


        <!-- Virtualization -->

        <Setter Property="EnableRowVirtualization"
                Value="True" />

        <Setter Property="EnableColumnVirtualization"
                Value="True" />

        <Setter Property="VirtualizingPanel.IsVirtualizing"
                Value="True" />

        <Setter Property="VirtualizingPanel.VirtualizationMode"
                Value="Recycling" />

        <Setter Property="ScrollViewer.CanContentScroll"
                Value="True" />


        <!-- Scrolling -->

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Auto" />

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto" />


        <!-- Crisp rendering -->

        <Setter Property="SnapsToDevicePixels"
                Value="True" />

        <Setter Property="UseLayoutRounding"
                Value="True" />

    </Style>
</ResourceDictionary>