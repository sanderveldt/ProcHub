<UserControl x:Class="ProcHub.Wpf.Features.ShippingTerms.Views.ShippingTermsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="ShippingTermsView_OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel>

            <TextBlock Text="{Binding Title}"
                       FontSize="28"
                       FontWeight="SemiBold" 
                       Margin="0,0,0,12"/>

            <UniformGrid Columns="2">
                <Border Margin="0,0,8,8"
                        Padding="12"
                        Background="{DynamicResource ControlFillColorDefaulBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel
                        Width="400"
                        Margin="18"
                        HorizontalAlignment="Left">

                        <TextBlock
                            Text="ID"
                            Margin="0,0,0,4" />

                        <TextBox
                            Text="{Binding Id, Mode=OneWay}"
                            IsReadOnly="True"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Left"
                            Width="40" />

                        <TextBlock
                            Text="Name"
                            Margin="0,0,0,4"/>

                        <TextBox
                            Text="{Binding 
                                Name,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left"
                            Height="40"
                            Width="150"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Margin="0,0,0,20" />

                        <TextBlock
                            Text="Description"
                            Margin="0,0,0,4" />

                        <TextBox 
                            Text="{Binding
                                Description_,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left"
                            Height="40"
                            Width="300"/>

                        <StackPanel
                            Orientation="Horizontal"
                            Width="400"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center">

                            <Button
                                Content="New"
                                Command="{Binding NewCommand}"
                                Width="100"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Center"/>

                            <Button
                                Content="Save"
                                Command="{Binding SaveCommand}"
                                Width="100"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Center"/>

                            <Button
                                Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Width="100"
                                Margin="0,0,8,0"/>




                        </StackPanel>

                    </StackPanel>




                </Border>

                <Border Margin="0,0,12,12"
                        Padding="18"
                        Background="{DynamicResource ControlFillColorDefaulBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>

                        <DataGrid
                            ItemsSource="{Binding ShippingTerms}"
                            SelectedItem="{Binding SelectedShippingTerm,
                                                   Mode=TwoWay}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">
                            
                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60" />

                                <DataGridTextColumn
                                    Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*" />

                                <DataGridTextColumn
                                    Header="Description"
                                    Binding="{Binding Description}"
                                    Width="2*" />

                            </DataGrid.Columns>

                        </DataGrid>


                    </StackPanel>

                </Border>

            </UniformGrid>

        </StackPanel>

    </ScrollViewer>
</UserControl>
