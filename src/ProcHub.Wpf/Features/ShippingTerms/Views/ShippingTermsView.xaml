<UserControl x:Class="ProcHub.Wpf.Features.ShippingTerms.Views.ShippingTermsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="ShippingTermsView_OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel>

            <StackPanel 
                Margin="0,0,0,6"
                Orientation="Horizontal"
                HorizontalAlignment="Left" >

                <Button
                    Content="New"
                    Command="{Binding NewCommand}"
                    Width="75"
                    Margin="2,0,0,0"
                    HorizontalAlignment="Center" />

                <Button
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Width="75"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Center" />

                <Button
                    Content="Delete"
                    Command="{Binding DeleteCommand}"
                    Width="75"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Center" />

            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,0,2,8"
                    Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel
                        Margin="8"
                        HorizontalAlignment="Left">

                        <TextBlock
                            Text="ID"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4" />

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBox
                                Text="{Binding Id, Mode=OneWay}"
                                FontWeight="DemiBold"
                                IsReadOnly="True"
                                Margin="0,0,0,20"
                                HorizontalAlignment="Left"
                                Width="40" />

                            <TextBlock
                                Text="{Binding ErrorMessage}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Margin="12,0,0,20"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="OrangeRed"/>

                        </StackPanel>

                        <TextBlock
                        Text="Name"
                        FontWeight="SemiBold"
                        Margin="0,0,0,4"/>

                        <TextBox
                        Text="{Binding Name,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Left"
                        Height="40"
                        Width="150"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Margin="0,0,0,20" />

                        <TextBlock
                            Text="Description"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4" />

                        <TextBox 
                            Text="{Binding Description,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left"
                            Height="40"
                            Width="300"/>

                    </StackPanel>

                </Border>

                <GridSplitter
                    Grid.Column="1"
                    Width="8"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns" 
                    ResizeBehavior="PreviousAndNext"
                    Background="Transparent"
                    Cursor="SizeWE" 
                    FocusVisualStyle="{x:Null}">

                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </GridSplitter.Template>

                </GridSplitter>


                <Border
                    Grid.Column="2" 
                    Margin="2,0,4,8"
                    Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock 
                            Text="{Binding Title}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="2,0,0,8" />

                        <DataGrid
                            ItemsSource="{Binding ShippingTerms}"
                            SelectedItem="{Binding SelectedShippingTerm,
                                            Mode=TwoWay}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60" />

                                <DataGridTextColumn
                                    Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*" />

                                <DataGridTextColumn
                                    Header="Description"
                                    Binding="{Binding Description}"
                                    Width="2*" />

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </Grid>
        </StackPanel>

    </ScrollViewer>
        
</UserControl>
