<UserControl x:Class="ProcHub.Wpf.Features.Suppliers.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel>

            <StackPanel
                Margin="0,0,0,6"
                Orientation="Horizontal"
                HorizontalAlignment="Left">

                <Button
                    Content="New"
                    Command="{Binding NewCommand}"
                    Width="75"
                    Margin="2,0,0,0" />

                <Button
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Width="75"
                    Margin="4,0,0,0" />

                <Button 
                    Content="Edit"
                    Command="{Binding EditCommand}"
                    Width="75"
                    Margin="4,0,0,0" />

                <Button
                    Content="Delete"
                    Command="{Binding DeleteCommand}"
                    Width="75"
                    Margin="4,0,0,0" />

            </StackPanel>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>


                <Border
                    Grid.Column="0"
                    Margin="0,0,2,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" >

                    <Grid Margin="16" >

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Code"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4" />

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Name"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4" />

                        <TextBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="{Binding Code, Mode=OneWay}"
                            FontWeight="DemiBold"
                            IsReadOnly="False"    
                            HorizontalAlignment="Left"
                            Width="125"
                            Margin="0,0,8,20" />
                        <!-- should bind IsCreating bool to IsReadOnly later -->

                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Name}"
                            HorizontalAlignment="Left"
                            Width="150"
                            Margin="0,0,8,20" />


                        <TextBlock
                            Grid.Row="2"
                            Text="Full Name"
                            FontWeight="SemiBold"
                            Margin="0,0,8,4" />

                        <TextBox
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="{Binding FullName}"
                            HorizontalAlignment="Left"
                            Width="300"
                            Margin="0,0,0,20" />


                        <TextBlock
                            Grid.Row="4"
                            Text="Default Payment Term"
                            FontWeight="SemiBold"
                            Margin="0,0,8,4" />

                        <!-- add PaymentTerm and Shipping api calls later for the comboboxes
                             load in ComboBox options array 
                             keep readonly true and set false when IsEditing or IsCreating
                             preload api calls in IsEditing and IsCreating methods, -client side cache? 
                         -->
                        <ComboBox
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            Width="300"
                            Margin="0,0,0,16"
                            />

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="Secondary Payment Term"
                            FontWeight="SemiBold"
                            Margin="0,0,8,4" />

                        <ComboBox
                            Grid.Row="7"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            Width="300"
                            Margin="0,0,0,16" 
                            />

                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="Sample Payment Term"
                            FontWeight="SemiBold"
                            Margin="0,0,8,4" />

                        <ComboBox
                            Grid.Row="9"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            Width="300"
                            Margin="0,0,0,16"
                            />


                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            Text="{Binding ErrorMessage}"
                            FontSize="14"
                            FontWeight="Bold"
                            TextWrapping="Wrap"
                            Foreground="OrangeRed"
                            Margin="0,0,4,8"  />

                    </Grid>

                </Border>

                <GridSplitter
                    Grid.Column="1"
                    Width="8"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Background="Transparent"
                    Cursor="SizeWE"
                    FocusVisualStyle="{x:Null}">

                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </GridSplitter.Template>

                </GridSplitter>

                <Border
                    Grid.Column="2"
                    Margin="2,0,4,8"
                    Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" >

                    <StackPanel>

                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="2,0,0,8" />

                        <DataGrid
                            ItemsSource="{Binding Suppliers}"
                            SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            SelectionMode="Single"
                            SelectionUnit="FullRow" >

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Code"
                                    Binding="{Binding Code}"
                                    Width="100" />

                                <DataGridTextColumn
                                    Header="Name"
                                    Binding="{Binding Name}"
                                    Width="150" />

                                <DataGridTextColumn
                                    Header="Full Name"
                                    Binding="{Binding FullName}"
                                    Width="250" />

                                <DataGridTextColumn
                                    Header="Payment Term"
                                    Binding="{Binding DefaultPaymentTerm}"
                                    Width="250" />

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</UserControl>