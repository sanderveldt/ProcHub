<UserControl x:Class="ProcHub.Wpf.Features.Users.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <DockPanel>


            <StackPanel
                DockPanel.Dock="Top"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" >

                <Button 
                    Content="New"
                    Width="75"
                    Margin="2,0,0,0"
                    />

                <Button 
                    Content="Save"
                    Width="75"
                    Margin="4,0,0,0"
                    />

                <Button 
                    Content="Edit"
                    Width="75"
                    Margin="4,0,0,0"
                    />

                <Button 
                    Content="Delete"
                    Width="75"
                    Margin="4,0,0,0"
                    />







            </StackPanel>



        </DockPanel>

    </ScrollViewer>

</UserControl>
