<UserControl x:Class="ProcHub.Wpf.Features.Users.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             Loaded="UsersView_OnLoaded" >

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <DockPanel>


            <StackPanel
                DockPanel.Dock="Top"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" >

                <Button 
                    Content="New"
                    Command="{Binding NewCommand}"
                    Width="75"
                    Margin="2,0,0,0"
                    />

                <Button 
                    Content="Save"
                    Click="Save_Click"
                    Width="75"
                    Margin="4,0,0,0"
                    />

                <Button 
                    Content="Edit"
                    Command="{Binding EditCommand}"
                    Width="75"
                    Margin="4,0,0,0"
                    />

                <Button 
                    Content="Delete"
                    Command="{Binding DeleteCommand}"
                    Width="75"
                    Margin="4,0,0,0"
                    />

            </StackPanel>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,2,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" >

                    <Grid Margin="16" >

                        <Grid.ColumnDefinitions>
                            
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                            
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="10" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="ID"
                            FontWeight="SemiBold"
                            Margin="0,4,0,8" />

                        <TextBox
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="{Binding Id, Mode=OneWay}"
                            FontWeight="DemiBold"
                            IsReadOnly="True"
                            HorizontalAlignment="Left"
                            Width="50"
                            Height="30"
                            Margin="0,0,8,20" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Email"
                            FontWeight="SemiBold"
                            Margin="0,4,0,4" />

                        <TextBox
                            Grid.Row="4"
                            Grid.Column="0"
                            Text="{Binding Email, 
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding IsEditorReadOnly}"
                            FontWeight="DemiBold"
                            HorizontalAlignment="Left"
                            Height="30"
                            Width="200"
                            Margin="0,0,8,20" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Text="Password"
                            FontWeight="SemiBold"
                            Margin="0,4,0,4" />

                        <PasswordBox
                            x:Name="NewPasswordBox"
                            Grid.Row="6"
                            Grid.Column="0"
                            IsEnabled="{Binding CanEditFields}"
                            HorizontalAlignment="Left"
                            Height="30"
                            Width="200"
                            Margin="0,0,8,20" />

                        <TextBlock
                            Grid.Row="7"
                            Grid.ColumnSpan="2"
                            Text="{Binding ErrorMessage}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="12,0,8,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="OrangeRed" />


                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="Display Name"
                            FontWeight="SemiBold"
                            Margin="0,4,0,4" />

                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding DisplayName,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding IsEditorReadOnly}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            Height="30"
                            Width="200"
                            Margin="0,0,8,20" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="Username"
                            FontWeight="SemiBold"
                            Margin="0,4,0,4" />

                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Text="{Binding UserName,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="{Binding IsEditorReadOnly}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            Height="30"
                            Width="200"
                            Margin="0,0,0,20" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="1"
                            Text="Role"
                            FontWeight="SemiBold"
                            Margin="0,4,0,4" />

                        <ComboBox
                            Grid.Row="6"
                            Grid.Column="1"
                            ItemsSource="{Binding Roles}"
                            SelectedValue="{Binding Role}"
                            IsEnabled="{Binding CanEditFields}"
                            HorizontalAlignment="Left" 
                            Width="200"
                            Margin="0,0,0,20"
                            />

                    </Grid>
                                      
                </Border>

                <GridSplitter
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="8"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Background="Transparent"
                    Cursor="SizeWE"
                    FocusVisualStyle="{x:Null}">

                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </GridSplitter.Template>

                </GridSplitter>

                <Border
                    Grid.Column="2"
                    Margin="2,0,4,8"
                    Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" >

                    <StackPanel>

                        <TextBlock 
                            Text="{Binding Title}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="2,0,0,8" />

                        <DataGrid
                            ItemsSource="{Binding Users}"
                            SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            SelectionMode="Single"
                            SelectionUnit="FullRow" >

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Id"
                                    Binding="{Binding Id}"
                                    Width="75" />

                                <DataGridTextColumn
                                    Header="DisplayName"
                                    Binding="{Binding DisplayName}"
                                    Width="150" />

                                <DataGridTextColumn
                                    Header="UserName"
                                    Binding="{Binding UserName}"
                                    Width="150" />

                                <DataGridTextColumn
                                    Header="Role"
                                    Binding="{Binding Role}"
                                    Width="100" />

                                <DataGridTextColumn
                                    Header="Email"
                                    Binding="{Binding Email}"
                                    Width="200" />

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </Grid>
            
        </DockPanel>

    </ScrollViewer>

</UserControl>
