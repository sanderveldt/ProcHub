<UserControl x:Class="ProcHub.Wpf.Features.PurchaseOrders.Dashboard.Views.DashboardView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:datevalidation="clr-namespace:ProcHub.Wpf.Infrastructure.Validation"
            xmlns:vm="clr-namespace:ProcHub.Wpf.Features.PurchaseOrders.Dashboard.ViewModels"
            Loaded="DashboardView_OnLoaded">

	<UserControl.Resources>

		<Style x:Key="DetailsSectionHeaderStyle"
               TargetType="{x:Type TextBlock}">

			<Setter Property="FontSize"
                    Value="14" />

			<Setter Property="FontWeight"
                    Value="SemiBold" />

			<Setter Property="Margin"
                    Value="0,0,0,8" />

			<Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}" />

		</Style>


		<Style x:Key="DetailsLabelStyle"
               TargetType="{x:Type TextBlock}">

			<Setter Property="FontSize"
                    Value="11" />

			<Setter Property="Margin"
                    Value="2,0,0,4" />

			<Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />

		</Style>


		<Style x:Key="DetailsValueStyle"
               TargetType="{x:Type TextBlock}">

			<Setter Property="Margin"
                    Value="2,5,0,0" />

			<Setter Property="FontWeight"
                    Value="SemiBold" />

			<Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />

		</Style>


		<Style x:Key="DetailsFieldStyle"
               TargetType="{x:Type StackPanel}">

			<Setter Property="Width"
                    Value="190" />

			<Setter Property="Margin"
                    Value="0,0,12,12" />

		</Style>


		<!-- Compact category buttons, with a visible active state. -->
		<Style x:Key="DashboardDetailsCategoryButtonStyle"
               TargetType="{x:Type Button}">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="Width" Value="62" />
			<Setter Property="Padding" Value="2,4" />
			<Setter Property="Margin" Value="0,0,3,0" />
			<Setter Property="Background" 
					Value="{DynamicResource AccentFillColorDisabledBrush}" />
		</Style>

		<Style x:Key="DashboardPaymentDetailsButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DashboardDetailsCategoryButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding ActiveDetailsSection}"
                             Value="{x:Static vm:DashboardDetailsSection.Payment}">
					<Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
					<Setter Property="BorderBrush"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardReferencesDetailsButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DashboardDetailsCategoryButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding ActiveDetailsSection}"
                             Value="{x:Static vm:DashboardDetailsSection.References}">
					<Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
					<Setter Property="BorderBrush"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardTimelineDetailsButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DashboardDetailsCategoryButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding ActiveDetailsSection}"
                             Value="{x:Static vm:DashboardDetailsSection.Timeline}">
					<Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
					<Setter Property="BorderBrush"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardLogisticsDetailsButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DashboardDetailsCategoryButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding ActiveDetailsSection}"
                             Value="{x:Static vm:DashboardDetailsSection.Logistics}">
					<Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
					<Setter Property="BorderBrush"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardStatusDetailsButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DashboardDetailsCategoryButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding ActiveDetailsSection}"
                             Value="{x:Static vm:DashboardDetailsSection.Status}">
					<Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
					<Setter Property="BorderBrush"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- The fields from the former long row-details panel, separated by category. -->
		<DataTemplate x:Key="PaymentDetailsSectionTemplate">
			<StackPanel>
				<!-- PAYMENT -->

				<TextBlock Text="Payment"
                           Style="{StaticResource DetailsSectionHeaderStyle}" />

				<WrapPanel>


					<!-- Payment term -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Payment term"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding PaymentTermDescription}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<!-- Order amount -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Order amount"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardEditingTextBoxStyle}"
                                 Text="{Binding OrderAmount,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus}" />

					</StackPanel>


					<!-- Deposit percentage -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Deposit"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding DepositPercentage,
                                                 StringFormat={}{0:P0}}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<!-- Deposit amount -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Deposit amount"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding DepositAmount,
                                                 StringFormat={}{0:N2}}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<!-- Deposit paid -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Deposit status"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<CheckBox Margin="2,7,0,0"
                                  Content="Deposit paid"
                                  IsChecked="{Binding DepositPaid,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />

					</StackPanel>


					<!-- Deposit paid date -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Deposit paid date"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="DepositPaidDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>

										<datevalidation:DateOnlyValidationRule
                                            DateFormat="dd-MM-yyyy" />

									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Balance -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Balance amount"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding BalanceAmount,
                                                 StringFormat={}{0:N2}}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<!-- Balance due -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Balance due"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding BalanceDueDate,
                                                 StringFormat={}{0:dd-MM-yyyy}}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<!-- Order paid -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Order status"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<CheckBox Margin="2,7,0,0"
                                  Content="Order paid"
                                  IsChecked="{Binding OrderPaid,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />

					</StackPanel>


					<!-- Balance paid date -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Balance paid date"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="BalancePaidDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>

										<datevalidation:DateOnlyValidationRule
                                            DateFormat="dd-MM-yyyy" />

									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>

				</WrapPanel>
			</StackPanel>
		</DataTemplate>

		<!-- The fields from the former long row-details panel, separated by category. -->
		<DataTemplate x:Key="ReferencesDetailsSectionTemplate">
			<StackPanel>
				<!-- REFERENCES -->

				<TextBlock Text="References"
                           Style="{StaticResource DetailsSectionHeaderStyle}" />

				<WrapPanel>


					<!-- Confirmation -->

					<StackPanel Width="230"
                                Margin="0,0,20,16">

						<TextBlock Text="Confirmation reference"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardEditingTextBoxStyle}"
                                 Text="{Binding ConfirmationReference,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />

					</StackPanel>


					<!-- Invoice -->

					<StackPanel Width="230"
                                Margin="0,0,20,16">

						<TextBlock Text="Invoice reference"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardEditingTextBoxStyle}"
                                 Text="{Binding InvoiceReference,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />

					</StackPanel>


					<!-- Shipment -->

					<StackPanel Width="230"
                                Margin="0,0,20,16">

						<TextBlock Text="Shipment reference"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardEditingTextBoxStyle}"
                                 Text="{Binding ShipmentReference,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />

					</StackPanel>


					<!-- Shipment size -->

					<StackPanel Width="160"
                                Margin="0,0,20,16">

						<TextBlock Text="Shipment size"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardEditingTextBoxStyle}"
                                 Text="{Binding ShipmentSize,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />

					</StackPanel>

				</WrapPanel>


				<!-- Notes -->

				<StackPanel Margin="0,0,0,16">

					<TextBlock Text="Order notes"
                               Style="{StaticResource DetailsLabelStyle}" />

					<TextBox MinHeight="72"
                             Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding OrderNotes,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />

				</StackPanel>
			</StackPanel>
		</DataTemplate>

		<!-- The fields from the former long row-details panel, separated by category. -->
		<DataTemplate x:Key="TimelineDetailsSectionTemplate">
			<StackPanel>
				<!-- TIMELINE -->

				<TextBlock Text="Order timeline"
                           Style="{StaticResource DetailsSectionHeaderStyle}" />

				<WrapPanel>


					<!-- Confirmation date -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Confirmation"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="ConfirmationDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Requested production -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Requested production"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="RequestedProductionDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Production done -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Production done"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="ProductionDoneDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Invoice -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Invoice date"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="InvoiceDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Shipping -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Shipping date"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="ShippingDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Bill of lading -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Bill of lading"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="BillOfLadingDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Arrival -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Arrival date"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="ArrivalDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Expected delivery -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Expected delivery"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="ExpectedDeliveryDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>


					<!-- Delivery -->

					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Delivery date"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBox Style="{StaticResource DashboardDateTextBoxStyle}">

							<TextBox.Text>

								<Binding Path="DeliveryDate"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         StringFormat="{}{0:dd-MM-yyyy}"
                                         ValidatesOnExceptions="True">

									<Binding.ValidationRules>
										<datevalidation:DateOnlyValidationRule />
									</Binding.ValidationRules>

								</Binding>

							</TextBox.Text>

						</TextBox>

					</StackPanel>

				</WrapPanel>
			</StackPanel>
		</DataTemplate>

		<!-- The fields from the former long row-details panel, separated by category. -->
		<DataTemplate x:Key="LogisticsDetailsSectionTemplate">
			<StackPanel>
				<!-- LOGISTICS -->

				<TextBlock Text="Logistics"
                           Style="{StaticResource DetailsSectionHeaderStyle}" />

				<WrapPanel>


					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Shipping term"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding ShippingTermName}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Production time"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding ProductionTimeDays,
                                                 StringFormat={}{0} days}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Shipping time"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding ShippingTimeDays,
                                                 StringFormat={}{0} days}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>


					<StackPanel Style="{StaticResource DetailsFieldStyle}">

						<TextBlock Text="Lead time"
                                   Style="{StaticResource DetailsLabelStyle}" />

						<TextBlock Text="{Binding LeadTimeDays,
                                                 StringFormat={}{0} days}"
                                   Style="{StaticResource DetailsValueStyle}" />

					</StackPanel>

				</WrapPanel>
			</StackPanel>
		</DataTemplate>

		<!-- The fields from the former long row-details panel, separated by category. -->
		<DataTemplate x:Key="StatusDetailsSectionTemplate">
			<StackPanel>
				<!-- STATUS FLAGS -->

				<TextBlock Text="Status flags"
                           Style="{StaticResource DetailsSectionHeaderStyle}" />

				<WrapPanel Margin="0,0,0,8">

					<CheckBox Margin="0,0,24,8"
                              Content="Confirmation sent"
                              IsChecked="{Binding ConfirmationSent}"
                              IsHitTestVisible="False"
                              Focusable="False" />

					<CheckBox Margin="0,0,24,8"
                              Content="Invoice sent"
                              IsChecked="{Binding InvoiceSent}"
                              IsHitTestVisible="False"
                              Focusable="False" />

					<CheckBox Margin="0,0,24,8"
                              Content="Inspection done"
                              IsChecked="{Binding InspectionDone}"
                              IsHitTestVisible="False"
                              Focusable="False" />

					<CheckBox Margin="0,0,24,8"
                              Content="Certificate of origin"
                              IsChecked="{Binding CertificateOfOriginSaved}"
                              IsHitTestVisible="False"
                              Focusable="False" />

				</WrapPanel>
			</StackPanel>
		</DataTemplate>

		<!-- Only one category is shown in the expanded row at a time. -->
		<DataTemplate x:Key="PurchaseOrderDetailsTemplate">
			<Border Margin="8,2,8,8"
                    Padding="8"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

				<StackPanel>
					<!-- Keep tall categories compact, with internal scrolling if needed. -->
					<ScrollViewer MaxHeight="225"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
						<ContentControl Content="{Binding}"
                                        HorizontalContentAlignment="Stretch">
							<ContentControl.Style>
								<Style TargetType="{x:Type ContentControl}">
									<Setter Property="ContentTemplate"
                                            Value="{StaticResource PaymentDetailsSectionTemplate}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding ActiveDetailsSection}"
                                                     Value="{x:Static vm:DashboardDetailsSection.References}">
											<Setter Property="ContentTemplate"
                                                    Value="{StaticResource ReferencesDetailsSectionTemplate}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding ActiveDetailsSection}"
                                                     Value="{x:Static vm:DashboardDetailsSection.Timeline}">
											<Setter Property="ContentTemplate"
                                                    Value="{StaticResource TimelineDetailsSectionTemplate}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding ActiveDetailsSection}"
                                                     Value="{x:Static vm:DashboardDetailsSection.Logistics}">
											<Setter Property="ContentTemplate"
                                                    Value="{StaticResource LogisticsDetailsSectionTemplate}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding ActiveDetailsSection}"
                                                     Value="{x:Static vm:DashboardDetailsSection.Status}">
											<Setter Property="ContentTemplate"
                                                    Value="{StaticResource StatusDetailsSectionTemplate}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ContentControl.Style>
						</ContentControl>
					</ScrollViewer>

					<!-- Save errors remain visible regardless of selected category. -->
					<!-- SAVE ERROR -->

					<TextBlock Margin="0,8,0,0"
                               Text="{Binding SaveError}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}">

						<TextBlock.Style>

							<Style TargetType="{x:Type TextBlock}">

								<Setter Property="Visibility"
                                        Value="Visible" />

								<Style.Triggers>

									<DataTrigger Binding="{Binding SaveError}"
                                                 Value="{x:Null}">

										<Setter Property="Visibility"
                                                Value="Collapsed" />

									</DataTrigger>

								</Style.Triggers>

							</Style>

						</TextBlock.Style>

					</TextBlock>
				</StackPanel>
			</Border>
		</DataTemplate>

	</UserControl.Resources>

	<!-- PAGE -->

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>


		<!-- HEADER -->

		<Grid Margin="0,0,0,16">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel>

				<TextBlock Text="Purchase Orders"
                           FontSize="24"
                           FontWeight="SemiBold" />

				<TextBlock Margin="0,4,0,0"
                           Text="Manage open purchase orders"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

			</StackPanel>

		</Grid>


		<!-- DATAGRID -->

		<DataGrid Grid.Row="1"
                  ItemsSource="{Binding PurchaseOrders}"
                  SelectedItem="{Binding SelectedPurchaseOrder,
                                         Mode=TwoWay}"
                  Style="{StaticResource DashboardDataGridStyle}"
                  RowDetailsTemplate="{StaticResource PurchaseOrderDetailsTemplate}"
                  FrozenColumnCount="3">

			<DataGrid.Columns>


				<!-- Five independent actions in one compact grid column.
                     The selected category is stored in DashboardRowViewModel. -->
				<DataGridTemplateColumn Header="Details"
                                        Width="333"
                                        CanUserSort="False"
                                        CanUserResize="False">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
								<Button Content="Pay ▾"
                                        ToolTip="Payment details"
                                        Style="{StaticResource DashboardPaymentDetailsButtonStyle}"
                                        Command="{Binding ToggleDetailsSectionCommand}"
                                        CommandParameter="{x:Static vm:DashboardDetailsSection.Payment}" />
								<Button Content="Refs ▾"
                                        ToolTip="References and notes"
                                        Style="{StaticResource DashboardReferencesDetailsButtonStyle}"
                                        Command="{Binding ToggleDetailsSectionCommand}"
                                        CommandParameter="{x:Static vm:DashboardDetailsSection.References}" />
								<Button Content="Dates ▾"
                                        ToolTip="Order timeline"
                                        Style="{StaticResource DashboardTimelineDetailsButtonStyle}"
                                        Command="{Binding ToggleDetailsSectionCommand}"
                                        CommandParameter="{x:Static vm:DashboardDetailsSection.Timeline}" />
								<Button Content="Ship ▾"
                                        ToolTip="Logistics and shipping"
                                        Style="{StaticResource DashboardLogisticsDetailsButtonStyle}"
                                        Command="{Binding ToggleDetailsSectionCommand}"
                                        CommandParameter="{x:Static vm:DashboardDetailsSection.Logistics}" />
								<Button Content="Flags ▾"
                                        ToolTip="Read-only status flags"
                                        Style="{StaticResource DashboardStatusDetailsButtonStyle}"
                                        Command="{Binding ToggleDetailsSectionCommand}"
                                        CommandParameter="{x:Static vm:DashboardDetailsSection.Status}" />
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>


				<!-- Purchase order -->

				<DataGridTextColumn Header="PO"
                                    Width="110"
                                    IsReadOnly="True"
                                    Binding="{Binding Code}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Supplier -->

				<DataGridTextColumn Header="Supplier"
                                    Width="220"
                                    IsReadOnly="True"
                                    Binding="{Binding SupplierName}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Order date -->

				<DataGridTextColumn Header="Order date"
                                    Width="110"
                                    IsReadOnly="True"
                                    Binding="{Binding OrderDate,
                                                      StringFormat={}{0:dd-MM-yyyy}}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Type -->

				<DataGridTextColumn Header="Type"
                                    Width="110"
                                    IsReadOnly="True"
                                    Binding="{Binding OrderType}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Status -->

				<DataGridTextColumn Header="Status"
                                    Width="125"
                                    IsReadOnly="True"
                                    Binding="{Binding OrderStatus}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Order amount -->

				<DataGridTemplateColumn Header="Amount"
                                        Width="125"
                                        CellStyle="{StaticResource DashboardEditorCellStyle}">

					<DataGridTemplateColumn.CellTemplate>

						<DataTemplate>

							<TextBox Style="{StaticResource DashboardInlineTextBoxStyle}"
                                     TextAlignment="Right"
                                     Text="{Binding OrderAmount,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=LostFocus}" />

						</DataTemplate>

					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>


				<!-- Deposit paid -->

				<DataGridTemplateColumn Header="Deposit"
                                        Width="85"
                                        CellStyle="{StaticResource DashboardEditorCellStyle}">

					<DataGridTemplateColumn.CellTemplate>

						<DataTemplate>

							<CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding DepositPaid,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}" />

						</DataTemplate>

					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>


				<!-- Order paid -->

				<DataGridTemplateColumn Header="Paid"
                                        Width="70"
                                        CellStyle="{StaticResource DashboardEditorCellStyle}">

					<DataGridTemplateColumn.CellTemplate>

						<DataTemplate>

							<CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding OrderPaid,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}" />

						</DataTemplate>

					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>


				<!-- Confirmation reference -->

				<DataGridTemplateColumn Header="Confirmation ref."
                                        Width="165"
                                        CellStyle="{StaticResource DashboardEditorCellStyle}">

					<DataGridTemplateColumn.CellTemplate>

						<DataTemplate>

							<TextBox Style="{StaticResource DashboardInlineTextBoxStyle}"
                                     Text="{Binding ConfirmationReference,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />

						</DataTemplate>

					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>


				<!-- Invoice reference -->

				<DataGridTemplateColumn Header="Invoice ref."
                                        Width="145"
                                        CellStyle="{StaticResource DashboardEditorCellStyle}">

					<DataGridTemplateColumn.CellTemplate>

						<DataTemplate>

							<TextBox Style="{StaticResource DashboardInlineTextBoxStyle}"
                                     Text="{Binding InvoiceReference,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />

						</DataTemplate>

					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>


				<!-- Shipping term -->

				<DataGridTextColumn Header="Shipping"
                                    Width="120"
                                    IsReadOnly="True"
                                    Binding="{Binding ShippingTermName}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Production -->

				<DataGridTextColumn Header="Production"
                                    Width="115"
                                    IsReadOnly="True"
                                    Binding="{Binding ProductionDoneDate,
                                                      StringFormat={}{0:dd-MM-yyyy}}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Shipping date -->

				<DataGridTextColumn Header="Shipped"
                                    Width="110"
                                    IsReadOnly="True"
                                    Binding="{Binding ShippingDate,
                                                      StringFormat={}{0:dd-MM-yyyy}}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Expected delivery -->

				<DataGridTextColumn Header="Expected"
                                    Width="115"
                                    IsReadOnly="True"
                                    Binding="{Binding ExpectedDeliveryDate,
                                                      StringFormat={}{0:dd-MM-yyyy}}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Delivery -->

				<DataGridTextColumn Header="Delivered"
                                    Width="115"
                                    IsReadOnly="True"
                                    Binding="{Binding DeliveryDate,
                                                      StringFormat={}{0:dd-MM-yyyy}}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Lead time -->

				<DataGridTextColumn Header="Lead"
                                    Width="80"
                                    IsReadOnly="True"
                                    Binding="{Binding LeadTimeDays,
                                                      StringFormat={}{0} d}"
                                    ElementStyle="{StaticResource DashboardCellTextStyle}" />


				<!-- Save status -->

				<DataGridTemplateColumn Width="44"
                                        CanUserSort="False"
                                        CanUserResize="False"
                                        CellTemplate="{StaticResource DashboardSaveStateCellTemplate}" />

			</DataGrid.Columns>

		</DataGrid>

	</Grid>

</UserControl>