<UserControl x:Class="ProcHub.Wpf.Shell.Views.SideNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ProcHub.Wpf.Shell.Models"
             Width="{Binding NavigationWidth}"
             MinWidth="56">

    <UserControl.Resources>

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        </Style>

        <Style x:Key="CompactNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
        </Style>

    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            
                 <!-- HEADER -->
                 
            <Grid Grid.Row="0" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Width="40"
                        Height="40"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleNavigationCommand}"
                        ToolTip="Expand or collapse navigation">

                    <TextBlock Text="&#xE700;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <TextBlock Grid.Column="1"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"
                           Text="ProcHub"
                           FontSize="18"
                           FontWeight="SemiBold">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCompact}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>


            <!-- BODY -->
            <Grid Grid.Row="1">

                <TreeView x:Name="NavigationTree"
                          Margin="8,4,4,4"
                          ItemsSource="{Binding NavigationItems}"
                          PreviewMouseLeftButtonUp="NavigationTree_PreviewMouseLeftButtonUp">

                    <TreeView.Style>
                        <Style TargetType="TreeView"
                               BasedOn="{StaticResource {x:Type TreeView}}">
                            <Setter Property="Visibility" Value="Visible" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCompact}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Style>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem"
                               BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="ToolTip"
                                    Value="{Binding Title}" />
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:NavigationItem}"
                                                  ItemsSource="{Binding Children}">

                            <Grid MinHeight="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           Text="{Binding IconGlyph}" />

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}" />
                            </Grid>

                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- COMPACT MODE -->
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCompact}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NavigationItem}">
                            <Button Style="{StaticResource CompactNavigationButtonStyle}"
                                    ToolTip="{Binding Title}"
                                    Click="CompactItem_Click">

                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="{Binding IconGlyph}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>

            <!-- SETTINGS -->
            <Border Grid.Row="2"
                    Margin="8,4,4,10"
                    Padding="0,8,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">

                <Button Command="{Binding SettingsCommand}"
                        ToolTip="Settings">

                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource NavigationButtonStyle}">
                            <Setter Property="Width" Value="Auto" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCompact}"
                                             Value="True">
                                    <Setter Property="Width" Value="44" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="16"
                                   Text="&#xE713;" />

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="Settings">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavigationCompact}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

            </Border>

        </Grid>
    </Border>
</UserControl>
